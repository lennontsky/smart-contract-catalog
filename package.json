{
        "name": "@kadena/tools",
        "version": "1.2.0",
        "private": true,
        "scripts": {
                "build": "next build",
                "build:e2e": "pnpm run generate:contracts && NODE_ENV=test next build",
                "dev": "next dev",
                "format": "pnpm run --sequential /^format:.*/",
                "format:lint": "pnpm run lint:src --fix",
                "format:md": "remark README.md -o --use @kadena-dev/markdown",
                "format:src": "prettier . --cache --write",
                "generate:coin:contract": "pactjs contract-generate --contract coin --api https://api.testnet.chainweb.com/chainweb/0.0/testnet04/chain/1/pact --chain 1 --network testnet",
                "generate:contracts": "pnpm run /^generate:.*:contract/",
                "generate:faucet:contract": "pactjs contract-generate --contract n_d8cbb935f9cd9d2399a5886bb08caed71f9bad49.coin-faucet --api https://api.testnet.chainweb.com/chainweb/0.0/testnet04/chain/1/pact --chain 1 --network testnet",
                "lint": "pnpm run /^lint:.*/",
                "lint:fmt": "prettier . --cache --check",
                "lint:pkg": "lint-package",
                "lint:src": "eslint src --ext .ts,.tsx",
                "start": "next start",
                "test": "vitest run",
                "test:watch": "vitest",
                "verify": "pnpm run generate:contracts && tsc --noEmit"
        },
        "dependencies": {
                "@hookform/resolvers": "^3.2.0",
                "@kadena/chainweb-node-client": "0.9.1",
                "@kadena/client": "^1.18.0",
                "@kadena/client-utils": "^0.13.0",
                "@kadena/cryptography-utils": "0.4.4",
                "@kadena/fonts": "~0.0.1",
                "@kadena/kode-icons": "^0.3.0",
                "@kadena/kode-ui": "^0.21.0",
                "@kadena/pactjs": "0.4.3",
                "@kadena/pactjs-generator": "1.18.0",
                "@ledgerhq/hw-transport": "^6.30.3",
                "@ledgerhq/hw-transport-webhid": "^6.28.3",
                "@ledgerhq/logs": "^6.12.0",
                "@tanstack/react-query": "^5.32.0",
                "@tryfabric/mack": "1.2.1",
                "@vanilla-extract/css": "1.14.2",
                "@walletconnect/modal": "~2.6.1",
                "@walletconnect/sign-client": "~2.8.1",
                "@walletconnect/utils": "^2.18.0",
                "ace-builds": "~1.30.0",
                "classnames": "^2.3.1",
                "fuse.js": "^7.0.0",
                "hw-app-kda": "^0.0.0",
                "js-cookie": "~3.0.5",
                "next": "14.2.26",
                "next-themes": "^0.2.1",
                "next-translate": "~2.0.6",
                "react": "^18.2.0",
                "react-ace": "^11.0.1",
                "react-dom": "^18.2.0",
                "react-hook-form": "^7.45.4",
                "react-use": "^17.4.0",
                "zod": "~3.23.0"
        },
        "devDependencies": {
                "@kadena-dev/shared-config": "^1.0.0",
                "@kadena/types": "0.7.0",
                "@rushstack/eslint-config": "~3.6.9",
                "@rushstack/heft": "~0.50.6",
                "@tanstack/eslint-plugin-query": "^5.28.11",
                "@testing-library/react": "~14.0.0",
                "@testing-library/user-event": "~14.5.1",
                "@total-typescript/ts-reset": "^0.5.1",
                "@types/debug": "~4.1.12",
                "@types/js-cookie": "~3.0.3",
                "@types/node": "^20.12.7",
                "@types/react": "^18.2.79",
                "@types/react-dom": "^18.2.25",
                "@vanilla-extract/next-plugin": "2.1.2",
                "@vanilla-extract/vite-plugin": "4.0.17",
                "@vitejs/plugin-react": "^4.3.1",
                "@vitest/coverage-v8": "^1.6.0",
                "@walletconnect/types": "~2.8.1",
                "@webpro/next-translate-plugin": "^2.6.3",
                "debug": "4.3.4",
                "dotenv": "~16.4.5",
                "eslint": "^8.45.0",
                "eslint-config-next": "13.4.5",
                "happy-dom": "^12.9.1",
                "next-router-mock": "^0.9.10",
                "prettier": "~3.2.5",
                "tsx": "^4.16.2",
                "typescript": "5.4.5",
                "vitest": "^1.6.0",
                "vitest-dom": "^0.1.1"
        },
        "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
